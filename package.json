{
  "name": "dsh-wsl-tool",
  "version": "2.2.2",
  "description": "Linux-native DSH, extended to WSL. Multi-step work shares one long-lived shell; one-off commands start fresh, in parallel, with timeouts. Files can be read, written, edited and searched inside the distribution. A terminal you opened is visible and read-only until you take the keyboard back; from WSL, `dsh` speaks into a chosen conversation. Path conversion, environment checks; destructive commands ask first. Runs as you, below the DSH sandbox.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XINY11451/dsh-wsl.git"
  },
  "homepage": "https://github.com/XINY11451/dsh-wsl#readme",
  "bugs": {
    "url": "https://github.com/XINY11451/dsh-wsl/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wsl",
    "windows",
    "linux",
    "shell",
    "interop"
  ],
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "SUPPORT.md",
    "PUBLISHING.md",
    "extras",
    "screenshots.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs",
    "test:real": "node test/smoke.mjs --real && node test/real-seam.mjs",
    "sync": "node scripts/sync-profile.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
